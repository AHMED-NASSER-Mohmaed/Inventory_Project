//- views/emails/contactAcknowledgement.pug
extends baseEmail

block content
  table(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tr
      td(style='padding: 20px;')
        h1(style='color: #2d3436; margin-bottom: 25px;') Thank you for contacting us, #{firstName}!
        p(style='font-size: 16px; line-height: 1.6;') #{_content}
        
       
        
        p(style='margin-top: 30px; font-size: 14px; color: #6c757d;')
          | For urgent matters, please call our support team 